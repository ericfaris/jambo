{
  "name": "jambo",
  "private": true,
  "version": "1.28.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/copy-receiver.mjs",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "fuzz": "tsx scripts/fuzz.ts",
    "fuzz:cast": "tsx scripts/cast-fuzz.ts",
    "fuzz:friend": "tsx scripts/cast-fuzz.ts 10 7000 ws://127.0.0.1:3031/ws friend",
    "server": "tsx src/multiplayer/server.ts",
    "ai:bench:short": "tsx scripts/ai-benchmark.ts short",
    "ai:bench:medium": "tsx scripts/ai-benchmark.ts medium",
    "ai:bench:long": "tsx scripts/ai-benchmark.ts long",
    "ai:ladder": "tsx scripts/ai-ladder.ts",
    "ai:telemetry:smoke": "tsx scripts/ai-telemetry-smoke.ts",
    "ai:profile": "tsx scripts/ai-turn-profile.ts",
    "version:bump": "tsx scripts/bump-version.ts patch",
    "version:minor": "tsx scripts/bump-version.ts minor",
    "version:major": "tsx scripts/bump-version.ts major"
  },
  "dependencies": {
    "mongodb": "^7.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.21.0",
    "ws": "^8.22.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.0"
  }
}
